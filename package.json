{
  "name": "gnome-shell-windows",
  "productName": "Adwaita Shell",
  "version": "0.1.0",
  "description": "A GNOME-inspired desktop shell for Windows",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "check": "node --check main.js && node --check preload.js && node --check renderer/app.js && node --check renderer/apps.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.communitypoke.adwaitashell",
    "productName": "Adwaita Shell",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
